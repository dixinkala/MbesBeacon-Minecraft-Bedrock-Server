# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/

# 测试与覆盖率
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
.nox/
.ruff_cache/

# 临时输出文件（误跟踪防御）
_rf*.txt
_run_tests.py
_debug_*.py
_test_out.txt

# PyInstaller
build/
dist/
*.spec.bak

# 本地设置与日志
.bedrock_server_manager_settings.json
.bedrock_server_manager_theme.json
.bedrock_server_manager_crash.log
.bedrock_server_hashes.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# 证书（不提交）
cert.pfx
*.pfx
*.cer
*.p12

# 环境变量 / 凭据（不提交）
# 本项目的签名口令通过 $env:CERT_PASS 传入，不需要 .env；
# 这里只做防御，避免以后引入本地配置时误提交密钥。
.env
.env.*
!.env.example
!.env.sample

# 本地临时备份（历史重写/素材回滚用，仅保存在本机仓库目录内）
_local_backup/
